enum TeamSort {
  ELO
  NAME
}

enum GameLocation {
  HOME
  AWAY
  NEUTRAL
}

enum GameResult {
  WIN
  LOSS
  TIE
  CANCELED
  UNKNOWN
}

type Record {
  wins: Int!
  losses: Int!
  ties: Int!
}

type EloRating {
  season: Int!
  rating: Float!
  rank: Int!
  """
  The rank of the team in the snapshot before this one in the same season. It is null when the
  season has no earlier snapshot, or when the team is not in that snapshot.
  """
  previousRank: Int
  asOf: String!
}

type GamePrediction {
  winProbability: Float!
  predictedResult: GameResult!
  teamRating: Float!
  opponentRating: Float!
  asOf: String!
}

type Game {
  id: ID!
  week: Int!
  date: String!
  opponentId: ID!
  opponentName: String!
  location: GameLocation!
  result: GameResult!
  teamScore: Int
  opponentScore: Int
  playoff: Boolean!
  notes: String
  prediction: GamePrediction
}

type Team {
  id: ID!
  season: Int!
  name: String!
  mascot: String
  city: String
  division: Int
  region: Int
  primaryColor: String
  secondaryColor: String
  record: Record!
  elo: EloRating
  eloHistory: [EloRating!]!
  schedule: [Game!]!
}

type Query {
  currentSeason: Int!
  seasons: [Int!]!
  teams(
    season: Int
    search: String
    region: Int
    division: Int
    sort: TeamSort = ELO
    limit: Int = 1000
  ): [Team!]!
  team(id: ID!, season: Int): Team
}
