enum TeamSort {
  RATING
  NAME
}

enum GameLocation {
  HOME
  AWAY
  NEUTRAL
}

enum GameResult {
  WIN
  LOSS
  TIE
  CANCELED
  UNKNOWN
}

type Record {
  wins: Int!
  losses: Int!
  ties: Int!
}

"""
The margin rating of a team on one date. A rating is a number of points. The gap between two
ratings of the same date is the margin that the model expects on a neutral field.
"""
type TeamRating {
  season: Int!
  """
  The rating in points. The value 0 has no meaning of its own, so compare two ratings of one date.
  """
  rating: Float!
  """
  The rating minus the median rating of the Ohio teams on the same date, so that 0 is the median
  team.
  """
  relativeRating: Float!
  rank: Int!
  """
  The rank of the team in the snapshot before this one in the same season. It is null when the
  season has no earlier snapshot, or when the team is not in that snapshot.
  """
  previousRank: Int
  asOf: String!
}

type GamePrediction {
  winProbability: Float!
  predictedResult: GameResult!
  """
  The margin that the model expects for this team, in points, with the home edge included. A
  negative margin is an expected loss.
  """
  predictedMargin: Float!
  teamRating: Float!
  opponentRating: Float!
  """
  The date of the prediction. It is the date of the game for a game played before the last
  update, and the date of the last update for a game not yet played.
  """
  asOf: String!
}

type Game {
  id: ID!
  week: Int!
  date: String!
  opponentId: ID!
  opponentName: String!
  location: GameLocation!
  result: GameResult!
  teamScore: Int
  opponentScore: Int
  playoff: Boolean!
  notes: String
  prediction: GamePrediction
}

type Team {
  """
  The key of the team in one season. A team has a different id in each season.
  """
  id: ID!
  season: Int!
  """
  The identifier of the team in its source. For a team from joeeitel.com, it is the number that
  joeeitel.com gives to the team. It stays the same from one season to the next.
  """
  sourceId: String!
  name: String!
  mascot: String
  city: String
  division: Int
  region: Int
  primaryColor: String
  secondaryColor: String
  record: Record!
  rating: TeamRating
  ratingHistory: [TeamRating!]!
  schedule: [Game!]!
}

type Query {
  currentSeason: Int!
  seasons: [Int!]!
  teams(
    season: Int
    search: String
    region: Int
    division: Int
    sort: TeamSort = RATING
    limit: Int = 1000
  ): [Team!]!
  team(id: ID!, season: Int): Team
}
