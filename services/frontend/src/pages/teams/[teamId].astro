---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro"
import { PRERENDER_TEAM_LIMIT } from "astro:env/server"
import SiteLayout from "@/layouts/site-layout.astro"
import { Container } from "@/components/ui/container"
import { Heading } from "@/components/ui/heading"
import { Link } from "@/components/ui/link"
import { paths } from "@/config/paths"
import { getCurrentSeason } from "@/features/seasons/api/get-current-season"
import { getTeam } from "@/features/teams/api/get-team"
import { getTeams } from "@/features/teams/api/get-teams"
import { ProgramHistory } from "@/features/teams/components/program-history"
import { RatingHistoryChart } from "@/features/teams/components/rating-history-chart"
import { TeamHeader } from "@/features/teams/components/team-header"
import { TeamScheduleTable } from "@/features/teams/components/team-schedule-table"
import { linkOpponents } from "@/features/teams/utils/opponent-links"
import { addOpponentSourceIds } from "@/features/teams/utils/opponent-logos"
import { addOpponentStandings } from "@/features/teams/utils/opponent-standings"
import { toSeasonRows } from "@/features/teams/utils/program-history"
import { teamPageHead } from "@/features/teams/utils/team-seo"
import { siteUrl } from "@/utils/seo"

/**
 * One page for every team of the current season. A team address holds no season, so a team that
 * did not play the current season has no page, and Pages answers its address with 404.html.
 */
export const getStaticPaths = (async () => {
  const [season, teams] = await Promise.all([getCurrentSeason(), getTeams()])

  const ids = [...new Set(teams.map((team) => team.id))]
  const drawn = PRERENDER_TEAM_LIMIT ? ids.slice(0, PRERENDER_TEAM_LIMIT) : ids
  // Each page is sent the ids of all pages, so its schedule links only to opponents with a page.
  return drawn.map((teamId) => ({ params: { teamId }, props: { season, pageTeamIds: drawn } }))
}) satisfies GetStaticPaths

const { teamId } = Astro.params
const { season, pageTeamIds } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>
// In the build, getStaticPaths already holds the list of teams, so this asks the API only once.
const [team, teams] = await Promise.all([getTeam(teamId, season), getTeams()])

// The chart, the schedule, and the program history run in the browser, so each is sent only the
// data it draws. Each opponent gets its current rank and rating, and its number for the logo, from
// the list of teams.
const ratingChart = { season: team.season, rating: team.rating, ratingHistory: team.ratingHistory }
const schedule = {
  name: team.name,
  schedule: addOpponentSourceIds(
    addOpponentStandings(linkOpponents(team.schedule, new Set(pageTeamIds)), teams),
    teams,
  ),
}
const programHistory = { name: team.name, rows: toSeasonRows(team) }
const head = teamPageHead(team, siteUrl(Astro.site), Astro.url.pathname)
---

<SiteLayout
  title={head.title}
  socialTitle={head.socialTitle}
  description={head.description}
  jsonLd={head.jsonLd}
>
  <main>
    <Container className="max-w-6xl py-10 sm:py-14 lg:py-16">
      <Link
        href={paths.leaderboard.getHref()}
        className="inline-flex text-sm/6 text-muted-fg hover:text-fg"
      >
        {`← ${team.season} Leaderboard`}
      </Link>

      <TeamHeader team={team} />

      <section class="mt-10" aria-labelledby="rating-history-heading">
        <Heading id="rating-history-heading" level={2} className="mb-4 text-lg/7 sm:text-lg/7">
          Rating By Season
        </Heading>
        <RatingHistoryChart client:visible team={ratingChart} />
      </section>

      <section class="mt-10" aria-labelledby="schedule-heading">
        <Heading id="schedule-heading" level={2} className="mb-4 text-lg/7 sm:text-lg/7">
          Schedule
        </Heading>
        <TeamScheduleTable client:visible team={schedule} />
      </section>

      <section class="mt-10" aria-labelledby="program-history-heading">
        <Heading id="program-history-heading" level={2} className="mb-4 text-lg/7 sm:text-lg/7">
          Program History
        </Heading>
        <ProgramHistory client:visible team={programHistory} />
      </section>
    </Container>
  </main>
</SiteLayout>
