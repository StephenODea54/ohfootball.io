---
import "@/styles.css"
import { AppFooter } from "@/components/layouts/app-footer"
import { AppNavbar } from "@/components/layouts/app-navbar"
import { visitorPathname } from "@/utils/pathname"
import { jsonLdScript, pageUrl, siteUrl } from "@/utils/seo"

interface Props {
  title: string
  description: string
  /** Tells search engines to leave the page out. */
  noindex?: boolean
  /** Structured data about the page, for search engines. */
  jsonLd?: object
  /** The title of a link preview. It is the title of the page when it is not set. */
  socialTitle?: string
}

const { title, description, noindex = false, jsonLd, socialTitle = title } = Astro.props

const pathname = visitorPathname(Astro.url.pathname)
// A page that search engines leave out has no address for them.
const canonical = noindex ? undefined : pageUrl(siteUrl(Astro.site), Astro.url.pathname)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <!-- The preview of a link to the page. The site has no image yet, so there is no og:image. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ohfootball.io" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLdScript(jsonLd)} />}
    <!-- Sets the theme before the page is painted, so a dark page does not flash light first. -->
    <script is:inline>
      ;(function () {
        try {
          var theme = localStorage.getItem("theme")
          var dark =
            theme === "dark" ||
            ((!theme || theme === "system") &&
              window.matchMedia("(prefers-color-scheme: dark)").matches)
          document.documentElement.classList.toggle("dark", dark)
          document.documentElement.style.colorScheme = dark ? "dark" : "light"
        } catch (e) {}
      })()
    </script>
  </head>
  <body>
    <AppNavbar client:idle pathname={pathname} />
    <slot />
    <AppFooter />
  </body>
</html>
