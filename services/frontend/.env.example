# https://design.intentui.com/docs/getting-started#get-your-token
REGISTRY_TOKEN=

# The build and the development server read the API here. No browser reads it.
GRAPHQL_URL=http://localhost:8082/graphql
# The build key. It must equal SITE_BUILD_KEY of the API. Without it, a full build gets 429 from
# the rate limits of the API.
GRAPHQL_API_KEY=
# Draws only this many team pages. Leave it empty to draw every team of the current season.
PRERENDER_TEAM_LIMIT=
# Set to true to show the Pick 'Em controls in the schedule of each team page. The value goes into
# the scripts of the site, so it is public. Leave it empty to hide Pick 'Em.
PUBLIC_PICKEM=
