# Ignore everything
*

# But descend into directories
!*/

# but still exclude generated folders
*.nitro
*.output
*.tanstack
*/bin
*dist
*node_modules

# CDK writes its templates here on every synth
infra/cdk.out

# And permit certain files
!.githooks/*
!.dockerignore
!.env.example
!.gitignore
!Dockerfile
!Dockerfile.*
!go.mod
!go.sum
!go.work
!go.work.sum
!LICENSE
!Makefile
!*.mk

# And filetypes
!*.conf
!*.css
!*.go
!*.graphqls
!*.html
!*.json
!*.md
!*.py
!*.sql
!*.toml
!*.ts
!*.tsx
!*.yaml
!*.yml

# The router writes this file while the dev server runs
todos.json

# dbt-generated artifacts
analytics/.user.yml
analytics/dbt_packages/
analytics/logs/
analytics/target/
