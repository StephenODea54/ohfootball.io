# Ignore everything
*

# But descend into directories
!*/

# but still exclude generated folders
*bin

# And permit certain files
!.githooks/*
!.dockerignore
!.env.example
!.gitignore
!Dockerfile
!go.mod
!go.sum
!go.work
!go.work.sum
!LICENSE
!Makefile

# And filetypes
!*.css
!*.go
!*.graphqls
!*.html
!*.json
!*.md
!*.py
!*.sql
!*.toml
!*.ts
!*.tsx
!*.yaml
!*.yml

# dbt-generated artifacts
analytics/.user.yml
analytics/dbt_packages/
analytics/logs/
analytics/target/
