# Ignore everything
*

# But descend into directories
!*/

# but still exclude generated folders
*/bin
**/build/
*dist
*node_modules

# And permit certain files
!.githooks/*
!.dockerignore
!.env.example
!.gitignore
!_headers
!Dockerfile
!Dockerfile.*
!go.mod
!go.sum
!go.work
!go.work.sum
!LICENSE
!Makefile
!*.mk

# And filetypes
!*.astro
!*.conf
!*.css
!*.go
!*.graphql
!*.graphqls
!*.htm
!*.html
!*.json
!*.md
!*.py
!*.sql
!*.toml
!*.ts
!*.tsx
!*.yaml
!*.yml

# And files with no extension that a tool reads
!.python-version
!.sqlfluff
!.sqlfluffignore

# dbt-generated artifacts
services/analytics/.user.yml
services/analytics/dbt_packages/
services/analytics/logs/
services/analytics/target/

# Astro writes its generated types here
services/frontend/.astro/

# Wrangler writes its local state here while it serves the site
services/frontend/.wrangler/

# What ruff and uv write
.ruff_cache/
.venv/

# Files of coding assistants. They stay on the machine and out of the repository.
.claude/
.agents/
.mcp.json
CLAUDE.md
skills-lock.json
