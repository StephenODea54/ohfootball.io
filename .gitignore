# Ignore everything
*

# But descend into directories
!*/

# but still exclude generated folders
*.nitro
*.output
*.tanstack
*/bin
*dist
*node_modules

# And permit certain files
!.githooks/*
!.dockerignore
!.env.example
!.gitignore
!_headers
!Dockerfile
!Dockerfile.*
!go.mod
!go.sum
!go.work
!go.work.sum
!LICENSE
!Makefile
!*.mk

# And filetypes
!*.conf
!*.css
!*.go
!*.graphqls
!*.htm
!*.html
!*.json
!*.md
!*.py
!*.sql
!*.toml
!*.ts
!*.tsx
!*.yaml
!*.yml

# The router writes this file while the dev server runs
todos.json

# dbt-generated artifacts
services/analytics/.user.yml
services/analytics/dbt_packages/
services/analytics/logs/
services/analytics/target/
