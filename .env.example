# The settings that docker compose reads from a file named .env beside compose.yaml. Copy this
# file to .env and set the values. Git ignores .env, and no Docker build reads it.
#
# An empty value is the same as no value. Each value below is the one that compose uses when the
# variable is empty. Never write a real key or token into this file.

# api. Lets a build of the site skip the contact rule and the rate limits. Set the same value as
# GRAPHQL_API_KEY in services/frontend/.env. Use at least 16 characters. Empty lets no request
# skip them.
SITE_BUILD_KEY=

# dbt. Where dbt finds the warehouse. The defaults name the postgres service of compose.yaml.
DBT_HOST=postgres
DBT_PORT=5432
DBT_USER=im_batman
DBT_PASSWORD=shhhhhhhhh
DBT_DATABASE=ohfootball
DBT_SCHEMA=ohfootball_stg

# pipeline. The year of the season that the weekly scrape reads, for example 2026. The scrape does
# not read the calendar.
SCRAPER_SEASON=

# dataset and pipeline. The Kaggle account, and the dataset as owner/slug. Only a publication
# needs them.
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_DATASET=

# dataset and pipeline. The Cloudflare account, the R2 token that writes the one bucket, and the
# name of the bucket. Only publish-download needs them.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# pipeline. The fine-grained token that starts the site workflow. See publish-site in
# infra/pipeline/Makefile.
SITE_WORKFLOW_TOKEN=
