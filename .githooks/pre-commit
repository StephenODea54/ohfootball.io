#!/bin/sh
#
# Runs the lint step, the vet step, and the test suites before each commit.
# Install with: make hooks
#
set -eu

fail() {
	printf 'pre-commit: %s\n' "$1" >&2
	exit 1
}

make lint || fail 'lint failed. Run "make fmt", then fix what "make lint" still reports'
make vet || fail 'vet failed'
make test || fail 'tests failed'
