#!/bin/sh
#
# Runs the format check, the vet step, and the test suites before each commit.
# Install with: make hooks
#
set -eu

fail() {
	printf 'pre-commit: %s\n' "$1" >&2
	exit 1
}

go_files=$(git ls-files '*.go')
if [ -n "$go_files" ]; then
	unformatted=$(printf '%s\n' "$go_files" | xargs gofmt -l)
	if [ -n "$unformatted" ]; then
		printf 'These files are not formatted:\n%s\n' "$unformatted" >&2
		fail 'run "make fmt"'
	fi
fi

make vet || fail 'vet failed'
make test || fail 'tests failed'
